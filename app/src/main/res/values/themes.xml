<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.SkuVahnCaptain" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/theme</item>
        <item name="colorPrimaryDark">@color/theme</item>
        <item name="colorAccent">@color/theme</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="OverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
    </style>

    <style name="CircularProgressapi" parent="Theme.AppCompat.Light">
        <item name="colorAccent">@color/black</item>
    </style>

    <style name="BottomNavigationView" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="FabStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end|bottom</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTint">@color/theme</item>
        <item name="tint">@color/white</item>
        <item name="useCompatPadding">true</item>
    </style>


    <style name="BottomNavigationView.Active" parent="@style/TextAppearance.AppCompat.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="rounded_corner">
        <item name="cornerSize">6dp</item>
    </style>

    <style name="button_theme" parent="android:Widget.Material.Button">
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:elevation">@dimen/_12sdp</item>
        <item name="android:fontFamily">@font/plexsans_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="textview_theme" parent="Widget.AppCompat.TextView">
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:fontFamily">@font/plexsans_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="button_cylinder_theme" parent="android:Widget.Button">
        <item name="android:layout_height">@dimen/_30sdp</item>
        <item name="android:layout_width">@dimen/_80sdp</item>
        <item name="android:textSize">@dimen/_9ssp</item>
        <item name="android:fontFamily">@font/plexsans_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/theme</item>
        <item name="android:gravity">center</item>
    </style>


    <style name="button_white" parent="android:Widget.Button">
        <item name="android:layout_height">@dimen/_45sdp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:elevation">@dimen/_12sdp</item>
        <item name="android:fontFamily">@font/plexsans_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_button_white</item>
    </style>

    <style name="field_label" parent="android:Widget.EditText">
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:fontFamily">@font/plexsans_regular</item>
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:paddingLeft">@dimen/_12sdp</item>
        <item name="android:paddingRight">@dimen/_12sdp</item>
    </style>

    <style name="field_disable_label" parent="android:Widget.EditText">
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:fontFamily">@font/plexsans_regular</item>
        <item name="android:background">@drawable/bg_edittext_disable</item>
        <item name="android:paddingLeft">@dimen/_12sdp</item>
        <item name="android:paddingRight">@dimen/_12sdp</item>
    </style>

    <style name="field_label_c" parent="android:Widget.EditText">
        <item name="android:layout_height">@dimen/_25sdp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">@dimen/_9ssp</item>
        <item name="android:fontFamily">@font/plexsans_regular</item>
        <item name="android:background">@drawable/bg_edittext</item>
        <item name="android:paddingLeft">@dimen/_8sdp</item>
        <item name="android:paddingRight">@dimen/_8sdp</item>
    </style>

    <style name="BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/bottomSheetStyleWrapper</item>
    </style>

    <style name="bottomSheetStyleWrapper" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="LabelText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_9sdp</item>
        <item name="android:fontFamily">@font/plexsans_bold</item>
        <item name="android:layout_marginBottom">@dimen/_4sdp</item>
    </style>

    <style name="ValueText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_9sdp</item>
        <item name="android:fontFamily">@font/plexsans_medium</item>
        <item name="android:layout_marginBottom">@dimen/_8sdp</item>
    </style>

    <style name="TextHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:fontFamily">@font/plexsans_semibold</item>
    </style>

    <style name="error_text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/_18sdp</item>
        <item name="android:layout_marginTop">@dimen/_2sdp</item>
        <item name="android:textColor">@color/red_error</item>
        <item name="android:textSize">@dimen/_9ssp</item>
        <item name="android:maxLines">2</item>
        <item name="android:visibility">gone</item>
    </style>

</resources>