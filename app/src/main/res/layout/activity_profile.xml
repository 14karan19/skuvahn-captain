<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:background="@color/light_blue"
            android:gravity="center|start"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ivBack"
                android:layout_width="@dimen/_50sdp"
                android:layout_height="match_parent"
                android:gravity="center">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_back" />

            </LinearLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_minus2sdp"
                android:fontFamily="@font/plexsans_medium"
                android:text="Captain Profile"
                android:textColor="@color/black"
                android:textSize="@dimen/_16ssp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/_16sdp">

                <!-- PROFILE PHOTO -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_24sdp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imgDriverProfile"
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="@dimen/_100sdp"
                        android:src="@drawable/ic_user_placeholder"
                        app:civ_border_color="@color/grey_300"
                        app:civ_border_width="1dp" />

                    <ImageView
                        android:id="@+id/btnPickProfileImage"
                        android:layout_width="@dimen/_28sdp"
                        android:layout_height="@dimen/_28sdp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_circle_theme"
                        android:padding="@dimen/_6sdp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white" />
                </FrameLayout>

                <!-- FULL NAME -->
                <EditText
                    android:id="@+id/etFullName"
                    style="@style/field_label"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:hint="Full Name"
                    android:inputType="textPersonName"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkest_gray" />

                <!-- MOBILE -->
                <EditText
                    android:id="@+id/etMobile"
                    style="@style/field_label"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:enabled="false"
                    android:hint="Mobile Number"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkest_gray" />

                <!-- EMAIL -->
                <EditText
                    android:id="@+id/etEmail"
                    style="@style/field_label"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="Email (Optional)"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkest_gray" />

                <!-- VEHICLE NUMBER -->
                <EditText
                    android:id="@+id/etVehicleNumber"
                    style="@style/field_label"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="Vehicle Number (KA01AB1234)"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkest_gray" />

                <!-- ADDRESS -->
                <EditText
                    android:id="@+id/etModel"
                    style="@style/field_label"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="Model"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkest_gray" />

                <EditText
                    android:id="@+id/etColor"
                    style="@style/field_label"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="Color"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkest_gray" />

                <!-- PINCODE -->
                <EditText
                    android:id="@+id/etSeat"
                    style="@style/field_label"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="Seating Capacity"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkest_gray" />

                <TextView
                    android:id="@+id/etInsuranceDate"
                    style="@style/field_label"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="Insurance Upto"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkest_gray" />

                <TextView
                    android:id="@+id/etPollutionDate"
                    style="@style/field_label"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:hint="Pollution Upto"
                    android:textColor="@color/black"
                    android:textColorHint="@color/darkest_gray" />

                <LinearLayout
                    android:id="@+id/hideLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- DOCUMENT SECTION -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_18sdp"
                        android:text="Upload Documents"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                    <!-- DRIVING LICENSE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_18sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDlStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Driving License"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnDl"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            app:cardBackgroundColor="@color/grey_100"
                            app:cardCornerRadius="@dimen/_6sdp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="Upload Document"
                                android:textColor="@color/theme" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_18sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAadhaarStatusFront"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aadhaar Card (Front)"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnAadhaarFront"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            app:cardBackgroundColor="@color/grey_100"
                            app:cardCornerRadius="@dimen/_6sdp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="Upload Document"
                                android:textColor="@color/theme" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_18sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAadhaarStatusBack"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aadhaar Card (Back)"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnAadhaarBack"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            app:cardBackgroundColor="@color/grey_100"
                            app:cardCornerRadius="@dimen/_6sdp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="Upload Document"
                                android:textColor="@color/theme" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_18sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRcStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehicle RC"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnRc"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            app:cardBackgroundColor="@color/grey_100"
                            app:cardCornerRadius="@dimen/_6sdp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="Upload Document"
                                android:textColor="@color/theme" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_18sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvInsuranceStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehicle Insurance"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnInsurance"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            app:cardBackgroundColor="@color/grey_100"
                            app:cardCornerRadius="@dimen/_6sdp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="Upload Document"
                                android:textColor="@color/theme" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_18sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPollutionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehicle Pollution"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnPollution"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_40sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            app:cardBackgroundColor="@color/grey_100"
                            app:cardCornerRadius="@dimen/_6sdp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="Upload Document"
                                android:textColor="@color/theme" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- SUBMIT -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_margin="@dimen/_18sdp"
                        app:cardBackgroundColor="@color/theme"
                        app:cardCornerRadius="@dimen/_8sdp">

                        <TextView
                            android:id="@+id/btnSubmit"
                            style="@style/button_theme"
                            android:text="Register" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDeleteAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginVertical="@dimen/_12sdp"
                    android:fontFamily="@font/plexsans_semibold"
                    android:text="@string/delete_account"
                    android:textColor="@color/red_error"
                    android:textSize="@dimen/_12sdp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>
