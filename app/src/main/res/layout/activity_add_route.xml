<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- MAP -->
        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- CENTER PIN -->
        <ImageView
            android:id="@+id/ivPin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="@color/red_error" />

        <LinearLayout
            android:id="@+id/searchLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:gravity="center">

            <EditText
                android:id="@+id/etSearch"
                style="@style/field_label_c"
                android:layout_height="@dimen/_34sdp"
                android:layout_weight="1"
                android:drawableEnd="@drawable/ic_search"
                android:hint="Search for area, street name..."
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textColorHint="@color/black" />

        </LinearLayout>

        <!-- BOTTOM SHEET -->
        <LinearLayout
            android:id="@+id/bottomSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_bottom_sheet"
            android:orientation="vertical"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Drag Handle -->
                    <View
                        android:layout_width="@dimen/_40sdp"
                        android:layout_height="@dimen/_4sdp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="8dp"
                        android:background="#CCCCCC" />

                    <!-- Address -->
                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/plexsans_regular"
                        android:text="Fetching location..."
                        android:textColor="#555" />

                    <!-- House -->
                    <EditText
                        android:id="@+id/etRouteStop"
                        style="@style/field_label_c"
                        android:layout_height="@dimen/_34sdp"
                        android:hint="Route Stop"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />

                    <!-- House -->
                    <EditText
                        android:id="@+id/etAddress"
                        style="@style/field_label_c"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginVertical="@dimen/_8sdp"
                        android:hint="Address"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />

                    <!-- Landmark -->
                    <EditText
                        android:id="@+id/etLandmark"
                        style="@style/field_label_c"
                        android:layout_height="@dimen/_34sdp"
                        android:hint="Nearby landmark (optional)"
                        android:imeOptions="actionNext"
                        android:maxLines="1"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/selectSchoolLayout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:outlineAmbientShadowColor="@color/light_gray"
                        android:outlineSpotShadowColor="@color/light_gray"
                        android:shadowColor="@color/light_gray"
                        app:cardBackgroundColor="@color/light_gray"
                        app:cardCornerRadius="@dimen/_8sdp"
                        app:cardElevation="@dimen/_6sdp"
                        tools:targetApi="p">

                        <LinearLayout
                            android:id="@+id/selectSchool"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <AutoCompleteTextView
                                android:id="@+id/actvSchool"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:completionThreshold="0"
                                android:dropDownHeight="wrap_content"
                                android:dropDownVerticalOffset="4dp"
                                android:fontFamily="@font/plexsans_medium"
                                android:gravity="center_vertical"
                                android:hint="@string/select_school"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:paddingHorizontal="@dimen/_10sdp"
                                android:textColor="@color/black"
                                android:textColorHint="@color/darkest_gray"
                                android:textSize="@dimen/_10ssp" />

                            <ImageView
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:layout_gravity="end|center"
                                android:layout_marginEnd="@dimen/_16sdp"
                                android:src="@drawable/ic_rounded_dropdown"
                                app:tint="@color/darkest_gray" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- SAVE BUTTON -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvSave"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_36sdp"
                        android:layout_marginVertical="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_36sdp"
                        app:cardBackgroundColor="@color/theme"
                        app:cardCornerRadius="@dimen/_6sdp"
                        app:cardElevation="2dp">

                        <TextView
                            android:id="@+id/btnSave"
                            style="@style/button_theme"
                            android:layout_height="@dimen/_36sdp"
                            android:gravity="center"
                            android:text="Save Route"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>